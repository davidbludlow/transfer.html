prior-art/send/**/node_modules
prior-art/send/**/coverage
prior-art/send/**/dist
prior-art/send/**/.env
prior-art/send/**/.idea
prior-art/send/**/.DS_Store
prior-art/send/**/.nyc_output
prior-art/send/**/.tox
prior-art/send/**/.pytest_cache
prior-art/send/**/*.iml
prior-art/send/**/android/app/src/main/assets
prior-art/send/**/ios/send-ios/assets/ios.js
prior-art/send/**/ios/send-ios/assets/vendor.js
prior-art/send/**/ios/send-ios.xcodeproj/project.xcworkspace/xcuserdata/*
prior-art/send/**/ios/send-ios.xcodeproj/xcuserdata/*
