# flyctl launch added from .gitignore
**/prior-art

# Playwright MCP and Playwright artifacts
**/.playwright-mcp
**/playwright-report
**/test-results
**/playwright/.cache
**/*.trace.zip

# flyctl launch added from prior-art/croc-src/.gitignore
# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
prior-art/croc-src/**/*.exe
prior-art/croc-src/**/*.exe~
prior-art/croc-src/**/*.dll
prior-art/croc-src/**/*.so
prior-art/croc-src/**/*.dylib

# Test binary, built with `go test -c`
prior-art/croc-src/**/*.test

# Output of the go coverage tool, specifically when used with LiteIDE
prior-art/croc-src/**/*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
prior-art/croc-src/**/go.work
prior-art/croc-src/**/go.work.sum

# Environment variables file
prior-art/croc-src/**/.env

# Croc builds
prior-art/croc-src/croc
prior-art/croc-src/**/croc_v*

