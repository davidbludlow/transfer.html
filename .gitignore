prior-art/
node_modules/

# Claude Code per-machine state (rules/skills/agents/commands/the root CLAUDE.md
# stay tracked by default).
.claude/CLAUDE.md
.claude/settings.local.json
.claude/scheduled_tasks.lock

# fly.toml is per-deploy (app name, region, machine size). Generated
# locally by `fly launch`. The maintainer's reference copy is in deploy.md.
fly.toml

# wrangler.toml is per-deploy (Worker name, KV namespace id,
# compatibility date, byte cap). Used for the optional metering sidecar
# (worker/sidecar.js). Reference template is in deploy.md.
wrangler.toml

# Playwright MCP and Playwright artifacts
.playwright-mcp/
playwright-report/
test-results/
playwright/.cache/
*.trace.zip

# Local empirical-test scratch (sparse files, ad-hoc Playwright harness, etc.)
.test-files/

# Untracked scratch dump from an exploratory research session. Local-only;
# not meant to be checked in.
research-notes.md
